# Public Supabase Client Config (Local default port 54321)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Private Supabase Service Role (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# App Environment
PUBLIC_APP_NAME="Firefighters Management System"
