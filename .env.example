PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
APP_ENV=local
# Name printed on operational documents such as delivery notes.
PUBLIC_INSTITUTION_NAME=Bomberos Voluntarios

# Admin seeding (`pnpm seed:admin`). Defaults and fixture users (operator, treasurer, collector,
# read-only) apply ONLY when APP_ENV=local and PUBLIC_SUPABASE_URL is localhost/127.0.0.1.
# Any other APP_ENV requires INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD (no fallbacks).
INITIAL_ADMIN_EMAIL=admin@firefighters.local
INITIAL_ADMIN_PASSWORD=Admin123456!
INITIAL_ADMIN_NAME=System Administrator
