{
	"name": "firefighters",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"preinstall": "npx --yes only-allow@1.2.2 pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && tsx scripts/check-palette.ts",
		"test": "vitest run",
		"test:integration": "scripts/with-db-lock.sh vitest run --config vitest.integration.config.ts",
		"test:e2e": "scripts/with-db-lock.sh playwright test",
		"test:e2e:full": "E2E_FULL=1 scripts/with-db-lock.sh playwright test",
		"test:pwa": "playwright test --config playwright.pwa.config.ts",
		"db:slot": "scripts/with-db-lock.sh",
		"db:slots:stop": "scripts/slots-stop.sh",
		"db:reset": "scripts/with-db-lock.sh scripts/db-reset.sh",
		"db:reset:fast": "scripts/with-db-lock.sh scripts/db-reset-fast.sh",
		"db:test": "scripts/with-db-lock.sh scripts/supabase-cli.sh test db",
		"db:test:parallel": "scripts/with-db-lock.sh scripts/test-db-parallel.sh",
		"seed:admin": "scripts/with-db-lock.sh tsx scripts/seed-admin.ts",
		"seed:demo": "scripts/with-db-lock.sh tsx scripts/seed-demo.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.49.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix",
			"tsx scripts/check-palette.ts"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22",
		"pnpm": ">=11"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@fontsource/ibm-plex-sans-condensed": "5.3.0",
		"@lucide/svelte": "1.78.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"exceljs": "^4.4.0",
		"zod": "^4.6.7"
	}
}
